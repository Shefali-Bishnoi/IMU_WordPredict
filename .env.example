# WordPredict — environment variables
#
# These are read directly by backend/config.js and backend/logger.js.
# Copy this file to `.env` in the same directory you run `npm start`
# from (typically inside backend/) and adjust as needed:
#
#   cp .env.example .env
#
# NOTE: the Node backend does NOT currently depend on `dotenv`
# (package.json has no such dependency), so a `.env` file is not
# loaded automatically just by existing. Use one of:
#
#   1. Node 20.6+:  node --env-file=.env src/server.js
#      (or add "start": "node --env-file=.env src/server.js" to
#      package.json's "scripts")
#   2. Add dotenv yourself: `npm install dotenv` and add
#      `import 'dotenv/config';` as the first line of src/server.js
#   3. Export the variables in your shell / process manager instead
#      of using a .env file at all (e.g. in a systemd unit, a Docker
#      ENV instruction, or your CI/deploy config).
#
# The Python inference API (app/main.py, run via `uvicorn app.main:app`)
# does not read any environment variables today -- its host/port are
# passed as CLI flags to uvicorn, e.g.:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000

# ---------------------------------------------------------------------
# Node.js realtime gateway (backend/config.js)
# ---------------------------------------------------------------------

# Port the Node backend (REST + WebSocket + served frontend) listens on.
PORT=4000

# Base URL of the Python FastAPI inference service this backend proxies
# to (app/main.py). Must include the scheme; no trailing slash.
PYTHON_BASE_URL=http://localhost:8000

# Timeout (milliseconds) for HTTP calls from the Node backend to the
# Python inference service (predict/session/commit/etc.). Increase this
# if you're running a much larger model or a slower machine and see
# PythonServiceError: "Python service unreachable" under normal load.
PYTHON_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Logging (backend/logger.js)
# ---------------------------------------------------------------------

# Set to any non-empty value to enable logger.debug(...) output
# (currently unused by verbosity level elsewhere, but read directly by
# logger.js). Leave unset/empty in production.
# DEBUG=1
